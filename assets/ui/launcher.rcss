    letter-spacing: 1dp;
}
.status-pill, .value-badge {
    padding: 9dp 15dp;
    font-size: 11dp;
}
.page-main {
    padding: 36dp 20dp 26dp 20dp;
}
.hero-copy {
    width: 46%;
