}
.self-test-row {
    padding: 8dp 0;
    font-size: 10dp;
}
.tile-button {
    min-height: 76dp;
    padding: 14dp 16dp;
}
.tile-title { font-size: 12dp; }
.tile-subtitle {
    margin-top: 6dp;
