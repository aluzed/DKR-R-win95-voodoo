    letter-spacing: 2.3dp;
}
h1 {
    margin: 0 0 26dp 0;
    font-size: 58dp;
    line-height: 1.03;
    letter-spacing: -1.2dp;
}
.hero-description {
    width: 96%;
    margin: 0;
