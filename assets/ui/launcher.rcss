}
.setting-row p, .controller-summary p {
    margin-top: 8dp;
    font-size: 11.5dp;
    line-height: 1.48;
}

/* Controls use the full available page width. The outer page can scroll at
   smaller window sizes while the binding list keeps its own predictable
   vertical viewport. */
.controls-page {
    padding: 18dp 14dp 12dp 14dp;
    overflow-y: auto;
}
.controls-page .subpage-heading {
    margin-bottom: 12dp;
}
.controller-summary {
    min-height: 72dp;
    margin-bottom: 12dp;
    padding: 13dp 18dp;
}
.controller-note {
    max-width: 52%;
    font-size: 11.5dp;
    line-height: 1.45;
}
.controls-layout {
    width: 100%;
    min-height: 468dp;
    display: flex;
    flex-direction: column;
}
.control-options {
    width: 100%;
    min-height: 100dp;
    margin-bottom: 12dp;
    padding: 12dp 14dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-width: 1dp;
    border-color: #29424d;
    border-radius: 8dp;
    background-color: #0a1821;
}
.control-options-copy {
    width: 22%;
    padding-right: 18dp;
}
.control-options-copy .card-title { margin-bottom: 7dp; }
.control-help {
    margin: 0;
    padding: 0;
    color: #839aa3;
    font-size: 10.5dp;
    line-height: 1.42;
    border-width: 0;
}
.control-option-row,
.control-option-button {
    width: 15%;
    min-height: 72dp;
    margin: 0 0 0 9dp;
    padding: 10dp 12dp;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    font-size: 10.5dp;
    line-height: 1.3;
    border-width: 1dp;
    border-color: #2a4550;
    border-radius: 6dp;
    background-color: #0c2029;
}
.control-option-row > span,
.control-option-button > span {
    margin-bottom: 9dp;
    color: #849aa3;
    font-size: 10dp;
}
.control-option-row > div {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.control-option-row strong,
.control-option-button strong {
    color: #f5f1e8;
    font-size: 12dp;
}
.mini-button {
    width: 30dp;
    height: 30dp;
    padding: 3dp 0 0 0;
    font-size: 16dp;
}
.controls-column-headings {
    height: 38dp;
    padding: 0 18dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    color: #7d949d;
    font-size: 10dp;
    font-weight: bold;
    letter-spacing: 1.2dp;
    border-width: 1dp;
    border-color: #29424d;
    border-radius: 8dp 8dp 0 0;
    background-color: #0a1821;
}
.controls-heading-action { width: 24%; }
.controls-heading-binding { width: 38%; }
.controls-list {
    width: 100%;
    height: 318dp;
    padding: 0 10dp 10dp 10dp;
    overflow-y: auto;
    border-width: 1dp;
    border-top-width: 0;
    border-color: #29424d;
    border-radius: 0 0 8dp 8dp;
    background-color: #081720;
}
.control-row {
    min-height: 62dp;
    padding: 9dp 8dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1dp;
    border-bottom-color: #19313b;
}
.control-action-name {
    width: 24%;
    padding-right: 18dp;
    font-size: 13dp;
    line-height: 1.3;
}
.binding-button,
.binding-readonly {
    width: 37%;
    min-height: 44dp;
    margin-left: 8dp;
    padding: 8dp 12dp;
}
.binding-type {
    font-size: 9dp;
    letter-spacing: 1dp;
}
.binding-value {
    margin-top: 5dp;
    font-size: 12dp;
    line-height: 1.25;
}
.game-page {
    padding: 24dp 22dp 16dp 22dp;
}
.game-header {
    min-height: 72dp;
    margin-bottom: 16dp;
}
.game-grid { gap: 15dp; }
.game-card { padding: 20dp; }
.game-status {
    margin-bottom: 16dp;
    font-size: 13dp;
    line-height: 1.45;
}
.boot-step {
    min-height: 66dp;
    padding: 10dp 0;
}
.boot-step > span {
    width: 34dp;
    height: 34dp;
    margin-right: 14dp;
    padding-top: 9dp;
    font-size: 9dp;
}
.boot-step strong { font-size: 12dp; }
.boot-step p {
    margin-top: 6dp;
    font-size: 10.5dp;
    line-height: 1.42;
}
.game-controller-name {
    min-height: 30dp;
    font-size: 11.5dp;
}
.stick-values, .button-mask { font-size: 10dp; }
.button-mask strong { font-size: 11.5dp; }
.modal {
    max-width: 640dp;
    padding: 30dp;
}
.modal h3 {
    margin: 10dp 0 16dp 0;
    font-size: 30dp;
}
.modal p {
    font-size: 13dp;
    line-height: 1.5;
}

/* Milestone 0.4 final legibility pass. No primary body copy is smaller than
   11dp at the minimum supported 1280x720 launcher size. */
.build-label { font-size: 12dp; }
.status-pill, .value-badge { font-size: 12dp; }
.status-kicker { font-size: 12dp; }
.status-title { font-size: 21dp; }
.status-description { font-size: 13dp; }
.detail-label { font-size: 10.5dp; }
.detail-value { font-size: 11.5dp; }
.detail-mono { font-size: 10.5dp; }
.action-index { font-size: 11dp; }
.action-title { font-size: 15dp; }
.action-subtitle { margin-top: 6dp; font-size: 12dp; line-height: 1.35; }
.action-lock { font-size: 11dp; }
#bottom-bar, .input-hints span { font-size: 11dp; }
.card-title { font-size: 13dp; }
.diagnostic-row { font-size: 12dp; }
.diagnostic-row strong { font-size: 11.5dp; }
.self-test-summary { font-size: 12.5dp; }
.self-test-row, .self-test-list { font-size: 11.5dp; }
.tile-title { font-size: 12.5dp; }
.tile-subtitle { font-size: 11.5dp; }
.setting-title { font-size: 13dp; }
.setting-row p, .controller-summary p { font-size: 12.5dp; }
.controller-note { font-size: 12dp; }
.control-help { font-size: 11.5dp; }
.control-option-row, .control-option-button { font-size: 11.5dp; }
.control-option-row > span, .control-option-button > span { font-size: 11dp; }
.control-option-row strong, .control-option-button strong { font-size: 13dp; }
.controls-column-headings { font-size: 11.5dp; }
.control-action-name { font-size: 14dp; }
.binding-type { font-size: 10.5dp; }
.binding-value { font-size: 13.5dp; }
.game-status { font-size: 14dp; }
.boot-step strong { font-size: 13dp; }
.boot-step p { font-size: 11.5dp; }
.game-controller-name { font-size: 12.5dp; }
.stick-values, .button-mask { font-size: 11.5dp; }
.button-mask strong { font-size: 13dp; }
.message-type { font-size: 11dp; }
.modal p { font-size: 14dp; }

/* Keep all three control columns spacious and aligned. */
.controls-heading-action, .control-action-name { width: 22%; }
.controls-heading-binding { width: 39%; }
.binding-button, .binding-readonly { width: 38%; margin-left: 4dp; }
.controls-list { height: 330dp; }
.control-row { min-height: 68dp; }

/* Milestone 0.4 readability correction after physical Windows testing.
   RmlUi dp values map closely enough to pixels that 9-12dp body copy was too
   small at 1600x900. These overrides intentionally favour readability. */
.build-label { font-size: 14dp; }
.status-pill, .value-badge { font-size: 14dp; }
.eyebrow { font-size: 14dp; margin-bottom: 18dp; }
h2 { font-size: 44dp; }
.hero-description { font-size: 18dp; line-height: 1.65; }
.legal-note { margin-top: 34dp; font-size: 14dp; line-height: 1.55; }
.status-kicker { font-size: 14dp; }
.status-title { margin-top: 9dp; margin-bottom: 10dp; font-size: 25dp; }
.status-description { font-size: 16dp; line-height: 1.52; }
.detail-label { font-size: 12dp; }
.detail-value { font-size: 13dp; }
.detail-mono { font-size: 11.5dp; }
.action { min-height: 72dp; margin-bottom: 10dp; padding: 12dp 18dp; }
.action-index { width: 42dp; font-size: 13dp; }
.action-title { font-size: 18dp; }
.action-subtitle { margin-top: 7dp; font-size: 14dp; line-height: 1.35; }
.action-arrow { font-size: 24dp; }
.action-lock { font-size: 13dp; }
#bottom-bar, .input-hints span { font-size: 13dp; }
.compact-button { min-height: 46dp; padding: 11dp 18dp; font-size: 13dp; }
.card-title { font-size: 15dp; }
.diagnostic-row { min-height: 43dp; font-size: 14dp; }
.diagnostic-row strong { font-size: 13.5dp; }
.self-test-summary { font-size: 14dp; }
.self-test-row, .self-test-list { font-size: 13dp; }
.tile-title { font-size: 14dp; }
.tile-subtitle { margin-top: 7dp; font-size: 12.5dp; line-height: 1.42; }
.setting-title { font-size: 15dp; }
.setting-row p, .controller-summary p { font-size: 14dp; line-height: 1.5; }
.controller-note { font-size: 13.5dp; line-height: 1.48; }
.control-help { font-size: 13dp; line-height: 1.45; }
.control-option-row, .control-option-button { min-height: 78dp; font-size: 13dp; }
.control-option-row > span, .control-option-button > span { font-size: 12.5dp; }
.control-option-row strong, .control-option-button strong { font-size: 14dp; }
.controls-column-headings { height: 44dp; font-size: 13dp; }
.controls-list { height: 365dp; }
.control-row { min-height: 76dp; }
.control-action-name { font-size: 16dp; }
.binding-button, .binding-readonly { min-height: 56dp; padding: 9dp 14dp; }
.binding-type { font-size: 12dp; }
.binding-value { margin-top: 6dp; font-size: 15dp; }
.game-status { font-size: 16dp; }
.boot-step strong { font-size: 15dp; }
.boot-step p { font-size: 13.5dp; line-height: 1.45; }
.game-controller-name { font-size: 14dp; }
.stick-values, .button-mask { font-size: 13dp; }
.button-mask strong { font-size: 15dp; }
.message-type { font-size: 13dp; }
.modal p { font-size: 16dp; }
