}
.compact-button {
    min-width: 104dp;
    min-height: 42dp;
    padding: 10dp 17dp;
    font-size: 11dp;
}
.card-title {
    margin-bottom: 12dp;
    font-size: 12dp;
    letter-spacing: 1.5dp;
}
.diagnostic-layout { gap: 16dp; }
.diagnostic-card { padding: 22dp; }
.diagnostic-row {
    min-height: 38dp;
    padding: 9dp 0;
    font-size: 11dp;
}
.diagnostic-row strong { font-size: 10dp; }
.self-test-summary {
    margin-bottom: 12dp;
    font-size: 12dp;
