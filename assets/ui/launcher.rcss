    padding: 16dp 18dp;
    font-size: 12dp;
    line-height: 1.48;
}
.legal-icon {
    margin-right: 15dp;
    font-size: 22dp;
}
.control-panel {
    width: 52%;
    max-width: 740dp;
}
.status-card {
    min-height: 150dp;
    padding: 22dp;
}
.status-orb {
    width: 58dp;
    height: 58dp;
    margin-right: 20dp;
    padding-top: 14dp;
