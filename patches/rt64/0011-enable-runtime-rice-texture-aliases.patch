+        bool calculateRiceAlias(State *state, const LoadTile &drawTile,
+                                uint32_t tlut, uint64_t &alias) {
+            const LoadOperation &loadOp = state->rdp->rice.lastLoadOpByTMEM[drawTile.tmem];
+            int bytesPerRow = 0;
+            int width = 0;
+            int height = 0;
+            if (loadOp.type == LoadOperation::Type::Tile) {
+                uint16_t tileWidth = (std::max((loadOp.tile.lrs >> 2) -
+                    (loadOp.tile.uls >> 2), 0) + 1) & 0x03FF;
+                const uint16_t tileHeight = (std::max((loadOp.tile.lrt >> 2) -
+                    (loadOp.tile.ult >> 2), 0) + 1) & 0x03FF;
+                if (loadOp.tile.masks != 0) {
+                    tileWidth = std::min(tileWidth, uint16_t(1U << loadOp.tile.masks));
+                }
+                bytesPerRow = loadOp.texture.width << loadOp.texture.siz >> 1;
+                width = std::min(tileWidth, loadOp.texture.width);
+                if (loadOp.tile.siz > drawTile.siz) {
+                    width <<= loadOp.tile.siz - drawTile.siz;
+                }
+                height = (loadOp.tile.maskt != 0)
+                    ? std::min(tileHeight, uint16_t(1U << loadOp.tile.maskt))
+                    : tileHeight;
+            }
+            else if (loadOp.type == LoadOperation::Type::Block) {
+                const int tileWidth = std::max((drawTile.lrs >> 2) -
+                    (drawTile.uls >> 2), 0) + 1;
+                const int tileHeight = std::max((drawTile.lrt >> 2) -
+                    (drawTile.ult >> 2), 0) + 1;
+                const int maskWidth = (drawTile.masks == 0)
+                    ? tileWidth : (1 << drawTile.masks);
+                const int maskHeight = (drawTile.maskt == 0)
+                    ? tileHeight : (1 << drawTile.maskt);
+                const bool clampS = (drawTile.masks == 0) || (drawTile.cms & G_TX_CLAMP);
+                const bool clampT = (drawTile.maskt == 0) || (drawTile.cmt & G_TX_CLAMP);
+                width = (clampS && tileWidth <= 256)
+                    ? std::min(maskWidth, tileWidth) : maskWidth;
+                height = ((clampT && tileHeight <= 256) || maskHeight > 256)
+                    ? std::min(maskHeight, tileHeight) : maskHeight;
+                if (drawTile.siz == G_IM_SIZ_32b) {
+                    bytesPerRow = drawTile.line << 4;
+                }
+                else if (loadOp.tile.lrt == 0) {
+                    bytesPerRow = drawTile.line << 3;
+                }
+                else {
+                    uint32_t dxt = loadOp.tile.lrt;
+                    if (dxt > 1) dxt = reverseDXT(dxt, loadOp.texture.width, loadOp.texture.siz);
+                    bytesPerRow = dxt << 3;
+                }
+            }
+            else {
+                return false;
+            }
+
+            if (width <= 0 || height <= 0 || bytesPerRow <= 0) return false;
+            const uint32_t commonOffset = (loadOp.tile.uls >> 2) <<
+                loadOp.texture.siz >> 1;
+            const uint32_t commonBytesPerRow = loadOp.texture.width <<
+                loadOp.texture.siz >> 1;
+            uint32_t rdramStart = 0;
+            if (loadOp.type == LoadOperation::Type::Block) {
+                rdramStart = loadOp.texture.address + commonOffset +
+                    commonBytesPerRow * loadOp.tile.ult;
+            }
+            else {
+                rdramStart = loadOp.texture.address + commonOffset +
+                    commonBytesPerRow * (loadOp.tile.ult >> 2);
+            }
+            const uint64_t expectedSize = uint64_t(height - 1) * bytesPerRow +
+                uint64_t(width << drawTile.siz >> 1);
+            constexpr uint64_t RdramBytes = uint64_t(RDRAMSize) + 1ULL;
+            if (expectedSize == 0 || rdramStart >= RdramBytes ||
+                expectedSize > RdramBytes - rdramStart) {
+                return false;
+            }
+
+            const uint8_t *textureBytes = state->RDRAM + rdramStart;
+            const uint32_t textureCRC = riceCRC32(textureBytes, width, height,
+                                                   drawTile.siz, bytesPerRow);
+            char identityBuffer[64];
+            int identityLength = std::snprintf(identityBuffer, sizeof(identityBuffer),
+                "%08x#%u#%u", textureCRC, drawTile.fmt, drawTile.siz);
+            if (identityLength <= 0 || identityLength >= int(sizeof(identityBuffer))) return false;
+
+            if (tlut > 0) {
+                const bool ci4 = drawTile.siz == G_IM_SIZ_4b;
+                const int32_t paletteTMEM = (RDP_TMEM_WORDS >> 1) +
+                    (ci4 ? (drawTile.palette << 4) : 0);
+                const LoadOperation &paletteLoadOp =
+                    state->rdp->rice.lastLoadOpByTMEM[paletteTMEM];
+                if (paletteLoadOp.type != LoadOperation::Type::Tile) return false;
+                const uint32_t paletteOffset = (paletteLoadOp.tile.uls >> 2) <<
+                    paletteLoadOp.texture.siz >> 1;
+                const uint32_t paletteBytesPerRow = paletteLoadOp.texture.width <<
+                    paletteLoadOp.texture.siz >> 1;
+                const uint32_t paletteStart = paletteLoadOp.texture.address +
+                    paletteOffset + paletteBytesPerRow * (paletteLoadOp.tile.ult >> 2);
+                const uint8_t maximumIndex = ci4
+                    ? maxCI4(textureBytes, width, height, bytesPerRow)
+                    : maxCI8(textureBytes, width, height, bytesPerRow);
+                const uint32_t paletteByteCount = (uint32_t(maximumIndex) + 1U) * 2U;
+                if (paletteStart >= RdramBytes || paletteByteCount > RdramBytes - paletteStart) {
+                    return false;
+                }
+                const uint32_t paletteCRC = riceCRC32(state->RDRAM + paletteStart,
+                    maximumIndex + 1, 1, 2, ci4 ? 32 : 512);
+                const int appended = std::snprintf(identityBuffer + identityLength,
+                    sizeof(identityBuffer) - identityLength, "#%08x", paletteCRC);
+                if (appended <= 0 || identityLength + appended >= int(sizeof(identityBuffer))) return false;
+            }
+
+            alias = riceNativeAlias(identityBuffer);
+            return true;
+        }
