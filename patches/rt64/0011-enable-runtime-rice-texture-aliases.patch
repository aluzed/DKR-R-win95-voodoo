+        uint32_t calculateDXT(uint32_t txl2words) {
+            return (txl2words == 0) ? 1U : (2048U + txl2words - 1U) / txl2words;
+        }
+
+        uint32_t txl2Words(uint32_t width, uint32_t size) {
+            static constexpr uint32_t SizeBytes[4] = { 0, 1, 2, 4 };
+            return (size == 0) ? std::max(1U, width / 16U)
+                               : std::max(1U, width * SizeBytes[size] / 8U);
+        }
+
+        int reverseDXT(uint32_t value, uint32_t width, uint32_t size) {
+            if (value == 0x800) return 1;
+            if (value <= 1) return 1;
+            int low = 2047 / value;
+            if (calculateDXT(low) > value) low++;
+            const int high = 2047 / (value - 1);
+            if (low == high) return low;
+            for (int candidate = low; candidate <= high; candidate++) {
+                if (txl2Words(width, size) == uint32_t(candidate)) return candidate;
+            }
+            return (low + high) / 2;
+        }
+
+        uint32_t riceCRC32(const uint8_t *source, int width, int height,
+                           int size, int rowStride) {
+            uint32_t result = 0;
+            const int bytesPerLine = width << size >> 1;
+            for (int y = height - 1; y >= 0; y--) {
+                uint32_t value = 0;
+                for (int x = bytesPerLine - 4; x >= 0; x -= 4) {
+                    std::memcpy(&value, source + x, sizeof(value));
+                    value ^= uint32_t(x);
+                    result = (result << 4) + ((result >> 28) & 15);
+                    result += value;
+                }
+                value ^= uint32_t(y);
+                result += value;
+                source += rowStride;
+            }
+            return result;
+        }
+
+        uint8_t maxCI8(const uint8_t *source, uint32_t width, uint32_t height,
+                       uint32_t rowStride) {
+            uint8_t result = 0;
+            for (uint32_t y = 0; y < height; y++) {
+                const uint8_t *row = source + rowStride * y;
+                for (uint32_t x = 0; x < width; x++) {
+                    result = std::max(result, row[x]);
+                    if (result == 0xFF) return result;
+                }
+            }
+            return result;
+        }
+
+        uint8_t maxCI4(const uint8_t *source, uint32_t width, uint32_t height,
+                       uint32_t rowStride) {
+            uint8_t result = 0;
+            width >>= 1;
+            for (uint32_t y = 0; y < height; y++) {
+                const uint8_t *row = source + rowStride * y;
+                for (uint32_t x = 0; x < width; x++) {
+                    result = std::max(result, uint8_t(row[x] >> 4));
+                    result = std::max(result, uint8_t(row[x] & 0xF));
+                    if (result == 0xF) return result;
+                }
+            }
+            return result;
+        }
+
+        uint64_t riceNativeAlias(const std::string &identity) {
+            constexpr uint64_t Offset = 14695981039346656037ULL;
+            constexpr uint64_t Prime = 1099511628211ULL;
+            constexpr char Domain[] = "dkr-r:rice:";
+            uint64_t hash = Offset;
+            for (const char *character = Domain; *character != '\0'; character++) {
+                hash = (hash ^ uint8_t(*character)) * Prime;
+            }
+            for (const unsigned char character : identity) {
+                const unsigned char lower = (character >= 'A' && character <= 'Z')
+                    ? static_cast<unsigned char>(character - 'A' + 'a') : character;
+                hash = (hash ^ lower) * Prime;
+            }
+            hash ^= hash >> 33;
+            hash *= 0xff51afd7ed558ccdULL;
+            hash ^= hash >> 33;
+            hash *= 0xc4ceb9fe1a85ec53ULL;
+            hash ^= hash >> 33;
+            return hash;
+        }
