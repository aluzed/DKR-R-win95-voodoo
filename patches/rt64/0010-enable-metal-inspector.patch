+
 #if defined(_WIN32)
 #   include "plume_d3d12.h"
 #endif
@@ -74,7 +79,13 @@ namespace RT64 {
         ImGui::StyleColorsDark();
 
         if (sdlWindow != nullptr) {
-            ImGui_ImplSDL2_InitForOther(sdlWindow);
+#       if defined(__APPLE__)
+            if (graphicsAPI == UserConfiguration::GraphicsAPI::Metal) {
+                ImGui_ImplSDL2_InitForMetal(sdlWindow);
+            }
+            else
+#       endif
+            ImGui_ImplSDL2_InitForOther(sdlWindow);
         }
         else {
 #       ifdef _WIN32
@@ -143,6 +154,22 @@ namespace RT64 {
             ImGui_ImplVulkan_Init(&initInfo);
             break;
         }
+        case UserConfiguration::GraphicsAPI::Metal: {
+#       if defined(__APPLE__)
+            MetalDevice *interfaceDevice = static_cast<MetalDevice *>(device);
+            const MetalSwapChain *interfaceSwapChain = static_cast<const MetalSwapChain *>(swapChain);
+            metalFrameTexture = device->createTexture(RenderTextureDesc::ColorTarget(
+                1, 1, interfaceSwapChain->desc.format));
+            if (metalFrameTexture == nullptr || !ImGui_ImplMetal_Init(interfaceDevice->mtl)) {
+                assert(false && "Unable to initialize the Metal Inspector backend.");
+                return;
+            }
+#       else
+            assert(false && "Unsupported Graphics API.");
+            return;
+#       endif
+            break;
+        }
         default:
             assert(false && "Unknown Graphics API.");
             return;
@@ -163,6 +190,15 @@ namespace RT64 {
             vulkanContext.reset(nullptr);
             break;
         }
+        case UserConfiguration::GraphicsAPI::Metal: {
+#       if defined(__APPLE__)
+            ImGui_ImplMetal_Shutdown();
+            metalFrameTexture.reset();
+#       else
+            assert(false && "Unsupported Graphics API.");
+#       endif
+            break;
+        }
         default:
             assert(false && "Unknown Graphics API.");
             break;
@@ -208,6 +242,21 @@ namespace RT64 {
             ImGui_ImplVulkan_NewFrame();
             break;
         }
+        case UserConfiguration::GraphicsAPI::Metal: {
+#       if defined(__APPLE__)
+            MetalTexture *interfaceTexture = static_cast<MetalTexture *>(metalFrameTexture.get());
+            MTL::RenderPassDescriptor *descriptor = MTL::RenderPassDescriptor::renderPassDescriptor();
+            MTL::RenderPassColorAttachmentDescriptor *attachment =
+                descriptor->colorAttachments()->object(0);
+            attachment->setTexture(interfaceTexture->mtl);
+            attachment->setLoadAction(MTL::LoadActionLoad);
+            attachment->setStoreAction(MTL::StoreActionStore);
+            ImGui_ImplMetal_NewFrame(descriptor);
+#       else
+            assert(false && "Unsupported Graphics API.");
+#       endif
+            break;
+        }
         default:
             assert(false && "Unknown Graphics API.");
             break;
@@ -254,6 +303,19 @@ namespace RT64 {
                 ImGui_ImplVulkan_RenderDrawData(drawData, interfaceCommandList->vk);
                 break;
             }
+            case UserConfiguration::GraphicsAPI::Metal: {
+#           if defined(__APPLE__)
+                MetalCommandList *interfaceCommandList =
+                    static_cast<MetalCommandList *>(commandList);
+                interfaceCommandList->checkActiveRenderEncoder();
+                ImGui_ImplMetal_RenderDrawData(
+                    drawData, interfaceCommandList->mtl,
+                    interfaceCommandList->activeRenderEncoder);
+#           else
+                assert(false && "Unsupported Graphics API.");
+#           endif
+                break;
+            }
             default:
                 assert(false && "Unknown Graphics API.");
                 break;
