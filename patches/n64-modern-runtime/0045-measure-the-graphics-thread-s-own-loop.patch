From: DKR-R Windows 95 port
Subject: [PATCH] Measure the graphics thread's own loop

Patches 0042 to 0044 measure the wall time on which no guest thread runs, charge
half of it to the renderer's display-list path, and leave 17% with no name.
Three candidates were tested and refuted -- the vertical interval, the scheduler
quantum, the synchronised buffer swap -- and the second established the time is
not idle: raise the guest threads' priority so they stop yielding it and the
frame stops finishing.

So it is measured here instead of guessed at again. The graphics thread counts
its rounds, the rounds that find nothing, and the span it spends awake -- closed
before the wait rather than after it, so the sleep is not folded into the work.

  [trace][gfx] rounds=N empty=N awake=N us

The awake span is split three ways -- by whether the round found anything, and
by what it found -- because a single mean fits two very different stories.

Measured at the title screen over 80.3 s:

  display-list rounds     389 x  49.10 ms = 19.10 s   23.8% of wall
    of which in send_dl   389 x  37.61 ms = 14.63 s   18.2%
    of which outside it   389 x  11.49 ms =  4.47 s    5.6%
  screen updates         3371 x   0.99 ms =  3.35 s    4.2%
  empty rounds           5594 x   0.01 ms =  0.03 s    0.0%

The poll costs nothing. The screen updates arrive 8.7 per rendered frame.

---
--- a/ultramodern/src/events.cpp
+++ b/ultramodern/src/events.cpp
@@ -8,6 +8,8 @@
 #include <memory>
 #include <queue>
 #include <cstring>
+#include <cstdio>
+#include <cstdlib>
 
 #include "blockingconcurrentqueue.h"
 
@@ -444,6 +446,48 @@
 std::atomic<ultramodern::renderer::SetupResult> renderer_setup_result = ultramodern::renderer::SetupResult::Success;
 std::atomic<ultramodern::renderer::GraphicsApi> renderer_chosen_api = ultramodern::renderer::GraphicsApi::Auto;
 
+/* **What the graphics thread does with its second.**
+ *
+ * The scheduler's idle accounting says 17% of the wall has no guest thread
+ * running and nothing being drawn, and raising guest priorities showed that time
+ * is not idle: take it away and the frame stops finishing. Somebody uses it, and
+ * this thread is the first suspect for a reason visible in its loop below -- it
+ * polls its queue on a one millisecond timeout, so it wakes a thousand times a
+ * second whether there is work or not.
+ *
+ * Three numbers settle it: how many times round the loop, how many of those
+ * found nothing, and how long the thread spent awake. The third is the answer;
+ * the first two say whether that time is work or polling. */
+static std::atomic<unsigned long long> g_gfx_rounds{0};
+static std::atomic<unsigned long long> g_gfx_empty{0};
+static std::atomic<unsigned long long> g_gfx_awake_us{0};
+/* **Split by whether the round had anything to do.**
+ *
+ * "Awake" is not "executing": a preempted thread is runnable and counts here,
+ * and on one emulated core it will be preempted often. A round that dequeued
+ * nothing does essentially no work -- it tests a boolean and loops -- so its
+ * awake time is almost pure preemption, and comparing the two means tells the
+ * difference between a loop that costs something and a loop that merely waits
+ * its turn. Without this split the 14.5% of the wall attributed to the loop
+ * cannot be read as work at all. */
+static std::atomic<unsigned long long> g_gfx_awake_empty_us{0};
+/* Split again, by what the round was handling. Subtracting the renderer's own
+   per-display-list mean from the thread's awake time leaves a remainder that two
+   very different stories fit equally well -- three thousand screen updates at two
+   milliseconds each, or four hundred display lists at sixteen milliseconds each
+   outside `send_dl`, the latter being where an eight-megabyte RDRAM snapshot is
+   released. Guessing between them is what the last three experiments were. */
+static std::atomic<unsigned long long> g_gfx_awake_task_us{0};
+static std::atomic<unsigned long long> g_gfx_awake_screen_us{0};
+static std::atomic<unsigned long long> g_gfx_task_n{0};
+static std::atomic<unsigned long long> g_gfx_screen_n{0};
+
+extern "C" unsigned long long dkr_clock_now_us(void) __attribute__((weak));
+extern "C" void dkr_diag_commit(void) __attribute__((weak));
+
+static const bool g_gfx_trace_on =
+    (dkr_clock_now_us != nullptr) && (std::getenv("DKR_TRACE_CPU") != nullptr);
+
 void gfx_thread_func(uint8_t* rdram, moodycamel::LightweightSemaphore* thread_ready, ultramodern::renderer::WindowHandle window_handle) {
     bool enabled_instant_present = false;
     using namespace std::chrono_literals;
@@ -472,12 +516,62 @@
     // Notify the caller thread that this thread is ready.
     thread_ready->signal();
 
+    unsigned long long gfx_awake_at = 0ULL;
+    unsigned long long gfx_last_report_us = 0ULL;
+    bool gfx_round_was_empty = false;
+    int gfx_round_kind = -1;   /* 0 sp task, 1 screen update, -1 neither */
+
     while (!exited) {
+        /* Closed before the wait, not after it: the span that counts runs from
+           waking to going back to sleep, and stamping it on the far side of the
+           wait would fold the sleep into the work. */
+        if (g_gfx_trace_on && gfx_awake_at != 0ULL) {
+            const unsigned long long span = dkr_clock_now_us() - gfx_awake_at;
+            g_gfx_awake_us.fetch_add(span);
+            if (gfx_round_was_empty) { g_gfx_awake_empty_us.fetch_add(span); }
+            if (gfx_round_kind == 0) {
+                g_gfx_awake_task_us.fetch_add(span);
+                g_gfx_task_n.fetch_add(1);
+            } else if (gfx_round_kind == 1) {
+                g_gfx_awake_screen_us.fetch_add(span);
+                g_gfx_screen_n.fetch_add(1);
+            }
+            gfx_round_kind = -1;
+        }
+
         // Try to pull an action from the queue
         Action action;
-        if (events_context.action_queue.wait_dequeue_timed(action, 1ms)) {
+        const bool got_action =
+            events_context.action_queue.wait_dequeue_timed(action, 1ms);
+
+        if (g_gfx_trace_on) {
+            const unsigned long long now = dkr_clock_now_us();
+            gfx_awake_at = now;
+            const unsigned long long rounds = g_gfx_rounds.fetch_add(1) + 1;
+            gfx_round_was_empty = !got_action;
+            if (!got_action) { g_gfx_empty.fetch_add(1); }
+            if (gfx_last_report_us == 0ULL) { gfx_last_report_us = now; }
+            if (now - gfx_last_report_us >= 5000000ULL) {
+                gfx_last_report_us = now;
+                std::fprintf(stderr,
+                             "[trace][gfx] rounds=%llu empty=%llu awake=%llu us "
+                             "awake-on-empty=%llu us task=%llu us/%llu "
+                             "screen=%llu us/%llu\n",
+                             rounds, (unsigned long long)g_gfx_empty.load(),
+                             (unsigned long long)g_gfx_awake_us.load(),
+                             (unsigned long long)g_gfx_awake_empty_us.load(),
+                             (unsigned long long)g_gfx_awake_task_us.load(),
+                             (unsigned long long)g_gfx_task_n.load(),
+                             (unsigned long long)g_gfx_awake_screen_us.load(),
+                             (unsigned long long)g_gfx_screen_n.load());
+                if (dkr_diag_commit) { dkr_diag_commit(); }
+            }
+        }
+
+        if (got_action) {
             // Determine the action type and act on it
             if (const auto* task_action = std::get_if<SpTaskAction>(&action)) {
+                gfx_round_kind = 0;
                 // The queued task owns an immutable RDRAM snapshot, so the CPU
                 // can safely recycle its live display-list buffers as soon as
                 // the emulated RSP completes. Deliver this edge before parsing
@@ -542,6 +636,7 @@
                 // printf("Renderer ProcessDList time: %d us\n", static_cast<u32>(std::chrono::duration_cast<std::chrono::microseconds>(renderer_end - renderer_start).count()));
             }
             else if (const auto* screen_update_action = std::get_if<ScreenUpdateAction>(&action)) {
+                gfx_round_kind = 1;
                 events_context.vi.update_screen_regs = screen_update_action->regs;
                 screen_update_action_pending.store(false);
                 renderer_context->update_screen();
