+    // message arrive apres, et `__scHandleRSP` dereference un pointeur nul.
+    //
+    // Sur le materiel, une interruption SP et un retour de balayage sont deux
+    // evenements independants dont l'ordre relatif n'est pas garanti. Les servir
+    // en premier est donc fidele, et cela suffit a les sortir de la famine. Leur
+    // ordre entre eux est preserve — c'est celui-la que le jeu observe.
+    {
+        std::vector<QueuedMessage> tous{};
+        while (external_messages.try_dequeue(to_send)) {
