+//     ifstream(path.string())    works
+//
+// path.string() is narrow on every platform and identical elsewhere, so this
+// costs nothing on the targets that were already working.
 std::ifstream recomp::open_input_backup_file(const std::filesystem::path& filepath, std::ios_base::openmode mode) {
