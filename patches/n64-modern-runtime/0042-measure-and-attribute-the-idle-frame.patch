                          (unsigned long long)g_guest_run_us.load(), wall, n,
                          wall ? (100ULL * g_guest_run_us.load()) / wall : 0ULL);
+            const unsigned long long idle_r = g_idle_us_rendering.load();
+            const unsigned long long idle_o = g_idle_us_other.load();
+            std::fprintf(stderr,
+                         "[trace][idle] none-running=%llu us (rendering=%llu "
+                         "other=%llu) intervals=%llu worst=%llu us share=%llu%%\n",
+                         idle_r + idle_o, idle_r, idle_o,
+                         (unsigned long long)g_idle_n.load(),
+                         (unsigned long long)g_idle_worst.load(),
+                         wall ? (100ULL * (idle_r + idle_o)) / wall : 0ULL);
             if (dkr_diag_commit) { dkr_diag_commit(); }
         }
+        if (tl_counted) {
+            tl_counted = false;
+            if (g_guest_running.fetch_sub(1) == 1) {
+                /* The last one out. Stamp the hour and ask the renderer what it
+                   is doing, because that is the answer this bucket carries. */
+                g_idle_renderer_busy.store(
+                    (dkr_renderer_busy != nullptr) ? dkr_renderer_busy() : -1);
+                g_idle_since.store(now);
+            }
+        }
     }
     thread_context->running.wait();
-    if (guest_time_enabled()) { tl_resumed_at = dkr_clock_now_us(); }
+    if (guest_time_enabled()) {
+        const unsigned long long woke_at = dkr_clock_now_us();
+        tl_resumed_at = woke_at;
+        if (!tl_counted) {
+            tl_counted = true;
+            if (g_guest_running.fetch_add(1) == 0) {
+                const unsigned long long since = g_idle_since.load();
+                if (since != 0ULL && woke_at > since) {
+                    const unsigned long long d = woke_at - since;
+                    if (g_idle_renderer_busy.load() == 1) {
+                        g_idle_us_rendering.fetch_add(d);
+                    } else {
+                        g_idle_us_other.fetch_add(d);
+                    }
+                    g_idle_n.fetch_add(1);
+                    unsigned long long worst = g_idle_worst.load();
+                    while (d > worst &&
+                           !g_idle_worst.compare_exchange_weak(worst, d)) {
+                    }
+                }
+            }
+        }
+    }
