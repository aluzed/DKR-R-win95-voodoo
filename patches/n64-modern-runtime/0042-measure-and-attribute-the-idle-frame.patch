+/* **The time when no guest thread is running at all, measured rather than
+   subtracted.**
+ *
+ * `guest-run` against `wall` leaves a remainder, and on 21 September 2026 that
+ * remainder was about a quarter of the frame -- larger than the whole 33.3 ms
+ * budget -- arrived at by subtracting this instrument's ratio from the
+ * renderer's per-display-list mean. Two instruments with different populations
+ * and different denominators should not be subtracted from one another, so the
+ * remainder is measured here instead: a count of running guest threads, and a
+ * stamp at each edge between one and none.
+ *
+ * It is also **attributed**, which is the point. When the last guest thread goes
+ * to sleep the renderer is asked whether it is inside a display list, and the
+ * interval is charged to one of two buckets. "Waiting for the renderer" and
+ * "waiting for something else" are different findings and the difference decides
+ * where the next work goes.
+ *
+ * `dkr_renderer_busy` is weak for the same reason the clock is: ultramodern is a
+ * dependency and cannot depend back on the game's renderer. A build without one
+ * links, and charges every wait to the unattributed bucket. */
+extern "C" int dkr_renderer_busy(void) __attribute__((weak));
+
+static std::atomic<int> g_guest_running{0};
+static std::atomic<unsigned long long> g_idle_since{0};
+static std::atomic<int> g_idle_renderer_busy{0};
+static std::atomic<unsigned long long> g_idle_us_rendering{0};
+static std::atomic<unsigned long long> g_idle_us_other{0};
+static std::atomic<unsigned long long> g_idle_n{0};
+static std::atomic<unsigned long long> g_idle_worst{0};
+/* A thread that has never been resumed was never counted, so it must not
+   decrement on its first wait. */
+static thread_local bool tl_counted = false;
+
 void wait_for_resumed(RDRAM_ARG UltraThreadContext* thread_context) {
     if (guest_time_enabled() && tl_resumed_at != 0) {
         const unsigned long long now = dkr_clock_now_us();
@@ -249,11 +282,52 @@
