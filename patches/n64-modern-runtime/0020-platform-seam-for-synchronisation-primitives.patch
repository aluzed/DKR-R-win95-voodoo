+#ifndef __LIBRECOMP_SYNC_HPP__
+#define __LIBRECOMP_SYNC_HPP__
+
+// Synchronisation primitives, with a seam for platforms that cannot use the
+// standard library's.
+//
+// This mirrors ultramodern/threading.hpp, and exists for the same reason: on
+// some platforms, merely *including* <mutex> is fatal. Windows 95 resolves
+// every import at load time, and <mutex> pulls in six symbols it does not
+// export -- four of them condition variables introduced with Windows Vista.
+// A binary that includes it refuses to start, whether or not it ever locks
+// anything.
+//
+// Note how this differs from fileio.hpp next to it. There, the *type*
+// std::filesystem::path works on that platform and only its operations do not,
+// so the type stays and all its uses stay with it. Here the types themselves
+// are the problem, so the names must change at every declaration. That is more
+// intrusive, and there is no way around it.
+//
+// A port supplies its own by defining two macros:
+//
+//     LIBRECOMP_PLATFORM_SYNC_HEADER   header to include, as a string
+//     LIBRECOMP_PLATFORM_SYNC_NS       namespace providing the types
+//
+// It must provide mutex, and lock_guard usable both with and without an
+// explicit template argument. That is all librecomp uses: recomp.cpp and
+// pi.cpp guard shared tables, and never wait on a condition or start a thread.
+//
+// Defining neither macro -- the default, and what every existing target does --
+// leaves the standard library in place, so this header changes nothing for them.
+
+namespace recomp::sync {
+
+#if defined(LIBRECOMP_PLATFORM_SYNC_HEADER)
+
+} // namespace recomp::sync
+
+#include LIBRECOMP_PLATFORM_SYNC_HEADER
+
+namespace recomp::sync {
+    using mutex = LIBRECOMP_PLATFORM_SYNC_NS::mutex;
+
+    template <typename M>
+    using lock_guard = LIBRECOMP_PLATFORM_SYNC_NS::lock_guard<M>;
+}
+
+#else
+
+} // namespace recomp::sync
+
+// The Windows 95 target never reaches this branch: it defines the two macros
+// above. Its subset checker reads text rather than preprocessor state, so the
+// exemption is stated per line.
+//
+// DKR-WIN95-ALLOW: branche des cibles modernes, jamais compilee sur Windows 95
+#include <mutex>
+
+namespace recomp::sync {
+    using std::lock_guard;
+    using std::mutex;
+}
+
+#endif
+
+#endif
