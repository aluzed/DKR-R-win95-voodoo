+    }
+#endif
     uint8_t* rom_addr = rom.data() + physical_addr - recomp::rom_base;
     for (size_t i = 0; i < num_bytes; i++) {
         MEM_B(i, ram_address) = *rom_addr;
@@ -82,6 +179,19 @@
 void recomp::do_rom_pio(uint8_t* rdram, gpr ram_address, uint32_t physical_addr) {
     assert((physical_addr & 0x3) == 0 && "PIO not 4-byte aligned in device, currently unsupported");
     assert((ram_address & 0x3) == 0 && "PIO not 4-byte aligned in RDRAM, currently unsupported");
+#if defined(DKR_TARGET_WIN95)
+    if (rom.empty() && rom_file != nullptr) {
+        recomp::sync::lock_guard lock{ rom_file_mutex };
+        const size_t offset = physical_addr - recomp::rom_base;
+        const uint8_t* block = rom_block(static_cast<uint32_t>(offset / kRomBlock));
+        const size_t within = offset % kRomBlock;   /* 4-aligned: never crosses a block */
+        MEM_B(0, ram_address) = block[within + 0];
+        MEM_B(1, ram_address) = block[within + 1];
+        MEM_B(2, ram_address) = block[within + 2];
+        MEM_B(3, ram_address) = block[within + 3];
+        return;
+    }
+#endif
     uint8_t* rom_addr = rom.data() + physical_addr - recomp::rom_base;
     MEM_B(0, ram_address) = *rom_addr++;
     MEM_B(1, ram_address) = *rom_addr++;
