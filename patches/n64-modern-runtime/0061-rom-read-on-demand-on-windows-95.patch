 static std::vector<uint8_t> rom;
 
+#if defined(DKR_TARGET_WIN95)
+/* --- The ROM read on demand, on Windows 95 (patch 0061) ----------------------- *
+ *
+ * ADR 0003 decided the ROM is read on demand, not held: twelve megabytes of a
+ * machine that may have thirty-two. The validated big-endian file is opened
+ * once; every PI DMA reads what it needs through a cache of 64 blocks of 16 KiB,
+ * one megabyte, direct-mapped by block number -- the audio streams its samples
+ * in many small reads, and those must not each go to the file system. Guest
+ * threads take turns, so the cache needs no more than the mutex below.
+ *
+ * `get_rom()` wants the whole image; nothing in this game asks for it, and if
+ * something does, the image is read in full at that moment and the log says
+ * so. */
+static FILE* rom_file = nullptr;
+static size_t rom_file_size = 0;
+constexpr size_t kRomBlock = 16 * 1024;
+constexpr size_t kRomBlocks = 64;
+static uint8_t rom_blocks[kRomBlocks][kRomBlock];
+static uint32_t rom_block_tag[kRomBlocks];     /* block number + 1, 0 = empty */
+static recomp::sync::mutex rom_file_mutex;
+static unsigned long rom_block_misses = 0;
+static unsigned long rom_reads = 0;
+/* Blocks in use, kRomBlocks unless DKR_ROM_CACHE_BLOCKS says fewer: a
+   diagnostic, for measuring the cache's size against the misses it costs. */
+static size_t rom_blocks_used = kRomBlocks;
+
+static const uint8_t* rom_block(uint32_t number) {
+    const size_t slot = number % rom_blocks_used;
+    if (rom_block_tag[slot] != number + 1) {
+        const size_t offset = static_cast<size_t>(number) * kRomBlock;
+        size_t got = 0;
+        if (offset < rom_file_size && std::fseek(rom_file, static_cast<long>(offset), SEEK_SET) == 0) {
+            got = std::fread(rom_blocks[slot], 1, kRomBlock, rom_file);
+        }
+        if (got < kRomBlock) { std::memset(rom_blocks[slot] + got, 0, kRomBlock - got); }
+        rom_block_tag[slot] = number + 1;
+        rom_block_misses++;
+    }
+    return rom_blocks[slot];
+}
+
+bool recomp::set_rom_file(const std::filesystem::path& path, size_t size) {
+    FILE* f = std::fopen(path.string().c_str(), "rb");
+    if (f == nullptr) { return false; }
+    recomp::sync::lock_guard lock{ rom_file_mutex };
+    if (rom_file != nullptr) { std::fclose(rom_file); }
+    rom_file = f;
+    rom_file_size = size;
+    std::memset(rom_block_tag, 0, sizeof(rom_block_tag));
+    rom = std::vector<uint8_t>{};
+    if (const char* blocks = std::getenv("DKR_ROM_CACHE_BLOCKS")) {
+        const long n = std::strtol(blocks, nullptr, 10);
+        if (n >= 1 && n <= static_cast<long>(kRomBlocks)) { rom_blocks_used = static_cast<size_t>(n); }
+    }
+    std::fprintf(stderr, "[rom] read on demand from %s, %u KB of cache\n",
+                 path.string().c_str(), static_cast<unsigned>(kRomBlock * rom_blocks_used / 1024));
+    return true;
+}
+#endif
+
 bool recomp::is_rom_loaded() {
+#if defined(DKR_TARGET_WIN95)
+    if (rom_file != nullptr) { return true; }
+#endif
     return !rom.empty();
 }
 
@@ -27,6 +91,17 @@
 }
 
 std::span<const uint8_t> recomp::get_rom() {
+#if defined(DKR_TARGET_WIN95)
+    if (rom.empty() && rom_file != nullptr) {
+        recomp::sync::lock_guard lock{ rom_file_mutex };
+        std::fprintf(stderr, "[rom] the whole image was asked for: read in full\n");
+        rom.resize(rom_file_size);
+        std::fseek(rom_file, 0, SEEK_SET);
+        if (std::fread(rom.data(), 1, rom.size(), rom_file) != rom.size()) {
+            std::fprintf(stderr, "[rom] the full read came back short\n");
+        }
+    }
+#endif
     return rom;
 }
 
