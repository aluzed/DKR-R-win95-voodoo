@@ -12,7 +12,32 @@
 #endif
 
 // Start time for the program
-static std::chrono::high_resolution_clock::time_point start_time = std::chrono::high_resolution_clock::now();
+/* **Patch 0055: a clock that moves.**
+ *
+ * Everything ultramodern times -- osGetCount, osGetTime, the game's timers, the
+ * VI thread's schedule -- used std::chrono::high_resolution_clock::now(). With
+ * mingw-w64 that is the system clock over winpthreads' CLOCK_REALTIME, and on
+ * Windows 95 it falls back to GetSystemTimeAsFileTime, which only moves with the
+ * scheduler's tick. Measured on the target: 4 steps in 200 ms, the largest
+ * 60 ms. The game's time advanced in jumps of a sixteenth of a second.
+ *
+ * steady_clock is CLOCK_MONOTONIC, which winpthreads takes from
+ * QueryPerformanceCounter, and that is the 8254 at 1,193,180 Hz here. The time
+ * points keep high_resolution_clock's type, so no signature changes: they are
+ * the system clock's reading at start-up plus the steady clock's advance since.
+ * These two statics are defined before start_time, which static initialisation
+ * order within one translation unit guarantees. */
+static const std::chrono::high_resolution_clock::time_point g_precise_base =
+    std::chrono::high_resolution_clock::now();
+static const std::chrono::steady_clock::time_point g_precise_steady_base =
+    std::chrono::steady_clock::now();
+
+std::chrono::high_resolution_clock::time_point ultramodern::precise_now() {
+    return g_precise_base + std::chrono::duration_cast<std::chrono::high_resolution_clock::duration>(
+        std::chrono::steady_clock::now() - g_precise_steady_base);
+}
+
+static std::chrono::high_resolution_clock::time_point start_time = ultramodern::precise_now();
 // Offset of the duration since program start used to calculate the value for osGetTime. 
 static int64_t ostime_offset = 0;
