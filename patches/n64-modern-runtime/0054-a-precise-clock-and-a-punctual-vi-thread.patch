 void set_dummy_vi(bool odd);
 
+/* Patch 0054: how late the VI thread wakes. Every retrace the game sees starts
+   here, after `sleep_until`, which on Windows 95 is a `Sleep` of whole
+   milliseconds on whatever the scheduler's tick allows. A retrace that arrives
+   late delays whatever the game was waiting on it for. Buckets: under 0.25, 1, 2,
+   4, 8 and 16 ms, and the rest. */
+static std::atomic<unsigned long long> g_vi_late_bins[7];
+static std::atomic<unsigned long long> g_vi_late_us{0};
+
 void vi_thread_func() {
     ultramodern::set_native_thread_name("VI Thread");
     // This thread should be prioritized over every other thread in the application, as it's what allows
@@ -446,14 +454,37 @@
         //    printf("No need to sleep\n");
         //}
         // Detect if there's more than a second to wait and wait a fixed amount instead for the next VI if so, as that usually means the system clock went back in time.
-        if (std::chrono::floor<std::chrono::seconds>(next - std::chrono::high_resolution_clock::now()) > 1s) {
+        if (std::chrono::floor<std::chrono::seconds>(next - ultramodern::precise_now()) > 1s) {
             // printf("Skipping the next VI wait\n");
-            next = std::chrono::high_resolution_clock::now();
+            next = ultramodern::precise_now();
         }
         ultramodern::sleep_until(next);
+        {
+            /* In whole microseconds on ultramodern's own base, both sides cast
+               separately: `next` comes out of mixed signed and unsigned duration
+               arithmetic, and subtracting it from now() directly gave nonsense. */
+            const long long now_us = (long long)std::chrono::duration_cast<std::chrono::microseconds>(
+                ultramodern::time_since_start()).count();
+            const long long due_us = (long long)((total_vis * 1000000ULL) /
+                                                 (60ULL * ultramodern::get_speed_multiplier()));
+            const long long late = now_us - due_us;
+            const unsigned long long l = late > 0 ? (unsigned long long)late : 0ULL;
+            const int bin = l < 250 ? 0 : l < 1000 ? 1 : l < 2000 ? 2 : l < 4000 ? 3
+                          : l < 8000 ? 4 : l < 16000 ? 5 : 6;
+            g_vi_late_bins[bin].fetch_add(1);
+            g_vi_late_us.fetch_add(l);
+        }
         auto time_now = ultramodern::time_since_start();
         // Calculate how many VIs have passed
         uint64_t new_total_vis = (time_now * (60 * ultramodern::get_speed_multiplier()) / 1000ms) + 1;
+        /* Patch 0055: a wake before the retrace is due is not a retrace. The loop
+           used to send the game a VI interrupt on every pass, and a coarse clock
+           woke it early often enough that the game received 66.5 retraces a
+           second instead of 60 -- and 109 with a sampling profiler forcing the
+           scheduler every millisecond. Nothing is sent until the count moves. */
+        if (new_total_vis <= total_vis) {
+            continue;
+        }
         if (new_total_vis > total_vis + 1) {
             //printf("Skipped % " PRId64 " frames in VI interupt thread!\n", new_total_vis - total_vis - 1);
         }
@@ -831,6 +862,21 @@
                              "[trace][vi] updates-enqueued=%llu skipped=%llu\n",
