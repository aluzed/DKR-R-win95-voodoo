+// How long does rendering a display list really take?
+//
+// This is the measurement that corrected the diagnosis rather than confirming it.
+//
+// The hypothesis was that a software Glide rendering exceeds the 167 ms that
+// eleven retraces at 60 Hz amount to, and therefore makes DKR's watchdog give
+// way. Measured: **worst case 60 ms over more than two thousand frames, zero
+// overruns**.
+//
+// With the reservation that counts, and that nearly went missing: this build uses
+// the **null renderer**. The 60 ms are the display list's traversal alone, with no
+// rasterisation. The measurement therefore refutes the hypothesis *for this
+// binary*, not for a real Glide rendering -- which will cost considerably more,
+// and will bring the budget question back. Which argues for publishing the edge
+// early: it is not a palliative but the only structure that holds when the
+// rendering gets heavier.
+//
+// What the measurement does establish: 60 ms of mere traversal already produce six
+// retraces per list. The threshold of eleven is not far, without a single line
+// having been rasterised.
+//
+// What the delay costs is not time but **retraces handled in the meantime**:
+// gCurRDPTaskCounter is reset to zero by __scExec when a task starts, then
+// incremented once per __scHandleRetrace. The measurement is kept because it goes
+// on watching the worst case, not because it validates anything.
+static std::atomic<unsigned> g_dl_worst_ms{0};
+static std::atomic<unsigned> g_dl_over_budget{0};
+static std::atomic<unsigned> g_dl_total{0};
+static void trace_dl_duration(std::chrono::high_resolution_clock::time_point start,
+                              std::chrono::high_resolution_clock::time_point end) {
+    const unsigned ms = static_cast<unsigned>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(end - start).count());
+    const unsigned n = g_dl_total.fetch_add(1) + 1;
+    unsigned worst = g_dl_worst_ms.load();
+    while (ms > worst && !g_dl_worst_ms.compare_exchange_weak(worst, ms)) {}
+    // 167 ms = eleven retraces at 60 Hz, the watchdog's exact threshold.
+    if (ms > 167u) { g_dl_over_budget.fetch_add(1); }
+    if (!trace_sp_enabled()) { return; }
+    if (n % 60u != 0u) { return; }
+    std::fprintf(stderr, "[trace][dl] rendered=%u worst=%u ms over-budget(>167ms)=%u\n",
+                 n, g_dl_worst_ms.load(), g_dl_over_budget.load());
+    // Force the log onto the disk. Without this, a hang leaves a zero-byte file
+    // whatever was written, and one cannot tell "the program stopped early" from
+    // "the program is still running".
+    diag_commit();
+}
