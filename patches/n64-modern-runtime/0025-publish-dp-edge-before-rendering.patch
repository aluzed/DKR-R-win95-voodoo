+// Defined by the game (game_main.cpp): flushes the log AND updates the directory
+// entry, failing which a frozen program leaves a zero-byte file. Declared weak so
+// that the trial binaries, which link ultramodern without the game, still link.
+//
+extern "C" void dkr_diag_commit(void) __attribute__((weak));
+static void diag_commit() { if (dkr_diag_commit) { dkr_diag_commit(); } }
+
 static std::atomic<unsigned> g_trace_submits{0};
 static std::atomic<unsigned> g_trace_sp{0};
 static std::atomic<unsigned> g_trace_dp{0};
@@ -284,6 +291,53 @@
                  g_trace_dp.load());
