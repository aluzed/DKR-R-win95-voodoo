+void ultramodern::acknowledge_external_message_src(EventMessageSource src) {
+    std::shared_ptr<MessageDeliveryState> delivery;
+    {
+        std::lock_guard lock{ pending_delivery_mutex };
+        auto& pending = pending_deliveries[static_cast<std::size_t>(src)];
+        if (pending.empty()) {
+            return;
+        }
+        delivery = std::move(pending.front());
+        pending.pop_front();
+    }
+    // The acknowledgement is emitted by the emulated event handler after it
+    // has cleared the scheduler's active task pointer. Only now may a fast host
+    // worker publish the dependent completion edge.
+    complete_delivery(delivery);
+}
 
