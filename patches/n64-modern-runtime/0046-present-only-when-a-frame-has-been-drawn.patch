+                std::fprintf(stderr,
+                             "[trace][vi] updates-enqueued=%llu skipped=%llu\n",
+                             (unsigned long long)g_updates_enqueued.load(),
+                             (unsigned long long)g_updates_skipped.load());
                 if (dkr_diag_commit) { dkr_diag_commit(); }
             }
         }
