+/* --- Exclusive sections: processor time where Windows 95 has none ------------ *
+ *
+ * Patch 0051. Windows 95 does not implement `GetThreadTimes`, so every figure
+ * this file reports is a wall interval, and on one processor a wall interval
+ * counts the time of whatever preempted the thread being timed. Under
+ * DKR_TRACE_EXCLUSIVE a section raises its thread to time-critical priority:
+ * no other thread of the process can run inside it, so its wall interval is its
+ * processor time.
+ *
+ * That also makes the guest rows exact, which is the point of keeping the
+ * implementation here rather than in the game. A guest thread cannot execute
+ * during an exclusive section on another host thread, so if one is counted as
+ * running at the time, the whole section is preemption and belongs to someone
+ * else. It is charged to that thread's `preempted` slot, and `ran - preempted`
+ * is what the thread actually used. A section taken while the idle thread is
+ * parked goes to its own bucket instead: `parked` already takes that time out.
+ *
+ * Nested sections -- `send_dl` inside the graphics thread's round -- change the
+ * priority and count their time only at the outermost level. */
+static const bool g_exclusive_on =
+    guest_time_enabled() && (std::getenv("DKR_TRACE_EXCLUSIVE") != nullptr);
+static thread_local int tl_exclusive_depth = 0;
+static std::atomic<int> g_counted_guest_id{-1};
+static std::atomic<int> g_idle_parked_now{0};
+static std::atomic<unsigned long long> g_preempted_by_id[DKR_GUEST_RUN_SLOTS];
+static std::atomic<unsigned long long> g_exclusive_while_parked_us{0};
+static std::atomic<unsigned long long> g_exclusive_us{0};
+
+void dkr_set_idle_parked(int parked) { g_idle_parked_now.store(parked); }
+
+extern "C" unsigned long long dkr_exclusive_enter(int* previous) {
+    if (!g_exclusive_on || tl_exclusive_depth++ != 0) {
+        return 0ULL;
+    }
+#if defined(_WIN32)
+    *previous = GetThreadPriority(GetCurrentThread());
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+#else
+    *previous = 0;
+#endif
+    return dkr_clock_now_us();
+}
+
+extern "C" void dkr_exclusive_leave(int previous, unsigned long long entered_at) {
+    if (!g_exclusive_on || --tl_exclusive_depth != 0) {
+        return;
+    }
+    const unsigned long long d = dkr_clock_now_us() - entered_at;
+    g_exclusive_us.fetch_add(d);
+    /* A guest thread's own section -- the snapshot, on the scheduler -- is its
+       own work, not preemption of it. */
+    if (!is_game_thread && g_guest_running.load() > 0) {
+        if (g_idle_parked_now.load() != 0) {
+            g_exclusive_while_parked_us.fetch_add(d);
+        } else {
+            int slot = g_counted_guest_id.load();
+            if (slot < 0 || slot >= DKR_GUEST_RUN_SLOTS) {
+                slot = DKR_GUEST_RUN_SLOTS - 1;
+            }
+            g_preempted_by_id[slot].fetch_add(d);
+        }
+    }
+#if defined(_WIN32)
+    SetThreadPriority(GetCurrentThread(), previous);
+#else
+    (void)previous;
+#endif
+}
