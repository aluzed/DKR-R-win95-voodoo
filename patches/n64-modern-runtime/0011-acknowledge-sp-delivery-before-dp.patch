+
+bool ultramodern::enqueue_external_message_src_and_wait(PTR(OSMesgQueue) mq, OSMesg msg, bool jam, EventMessageSource src) {
+    if (mq == NULLPTR) {
+        return true;
+    }
+    auto delivery = std::make_shared<MessageDeliveryState>();
+    external_messages.enqueue({
+        mq, msg, jam, requeue_enabled[static_cast<int>(src)], delivery});
+    std::unique_lock lock{ delivery->mutex };
+    while (!delivery->complete && !exited.load()) {
+        delivery->condition.wait_for(lock, std::chrono::milliseconds{1});
+    }
+    return delivery->complete;
 }
 
