 std::bitset<32> requeue_enabled;
 extern std::atomic_bool exited;
 
+static void complete_delivery(const std::shared_ptr<MessageDeliveryState>& delivery) {
+    if (delivery == nullptr) {
+        return;
+    }
+    {
+        std::lock_guard lock{ delivery->mutex };
+        delivery->complete = true;
+    }
+    delivery->condition.notify_all();
+}
