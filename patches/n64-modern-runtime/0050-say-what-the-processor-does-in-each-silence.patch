--- a/ultramodern/src/threads.cpp
+++ b/ultramodern/src/threads.cpp
@@ -269,6 +269,22 @@
  * dependency and cannot depend back on the game's renderer. A build without one
  * links, and charges every wait to the unattributed bucket. */
 extern "C" int dkr_renderer_busy(void) __attribute__((weak));
+/* **And the audio microcode, patch 0050.** Half the silence is "other", and
+ * the audio microcode runs on the SP task thread, outside every guest thread:
+ * on one processor its time can only appear as a silence. The renderer's bit is
+ * sampled only when the silence starts; both bits are now sampled at its start
+ * **and** its end, and the interval charged to the union. A silence that begins
+ * in a display list and ends in an audio task is both, and a start-only sample
+ * would call it rendering. */
+extern "C" int dkr_audio_busy(void) __attribute__((weak));
+static std::atomic<int> g_idle_mask_at_start{0};
+static std::atomic<unsigned long long> g_idle_by_mask[4];
+static int host_activity_mask() {
+    int mask = 0;
+    if (dkr_renderer_busy != nullptr && dkr_renderer_busy() == 1) { mask |= 1; }
+    if (dkr_audio_busy != nullptr && dkr_audio_busy() == 1) { mask |= 2; }
+    return mask;
+}
 
