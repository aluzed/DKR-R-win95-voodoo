--- a/ultramodern/src/mesgqueue.cpp
+++ b/ultramodern/src/mesgqueue.cpp
@@ -7,6 +7,7 @@
 #include <memory>
 #include <mutex>
 #include <thread>
+#include <utility>
 
 #include "blockingconcurrentqueue.h"
 
@@ -27,7 +28,65 @@ struct QueuedMessage {
     bool has_source = false;
 };
 
-static moodycamel::BlockingConcurrentQueue<QueuedMessage> external_messages {};
+// This queue sits on the only wakeup path for every emulated hardware event.
+// ConcurrentQueue's implicit-producer dequeue can spin indefinitely while
+// reporting hundreds of queued items under DKR's mix of VI, AI, SP and DP
+// producers. A conventional FIFO is plenty fast at N64 event rates and gives
+// the cooperative CPU scheduler a deterministic wakeup boundary.
+class ExternalMessageQueue {
+public:
+    bool enqueue(QueuedMessage message) {
+        {
+            std::lock_guard lock{ mutex_ };
+            messages_.push_back(std::move(message));
+        }
+        condition_.notify_one();
+        return true;
+    }
+
+    bool try_dequeue(QueuedMessage& message) {
+        std::lock_guard lock{ mutex_ };
+        if (messages_.empty()) {
+            return false;
+        }
+        message = std::move(messages_.front());
+        messages_.pop_front();
+        return true;
+    }
+
+    void wait_dequeue(QueuedMessage& message) {
+        std::unique_lock lock{ mutex_ };
+        condition_.wait(lock, [this] { return !messages_.empty(); });
+        message = std::move(messages_.front());
+        messages_.pop_front();
+    }
+
+    template <typename Rep, typename Period>
+    bool wait_dequeue_timed(
+        QueuedMessage& message,
+        const std::chrono::duration<Rep, Period>& timeout) {
+        std::unique_lock lock{ mutex_ };
+        if (!condition_.wait_for(lock, timeout,
+                                 [this] { return !messages_.empty(); })) {
+            return false;
+        }
+        message = std::move(messages_.front());
+        messages_.pop_front();
+        return true;
+    }
+
+    std::size_t size_approx() const {
+        std::lock_guard lock{ mutex_ };
+        return messages_.size();
+    }
+
+private:
+    mutable std::mutex mutex_;
+    std::condition_variable condition_;
+    std::deque<QueuedMessage> messages_;
+};
+
+static ExternalMessageQueue external_messages{};
 static std::mutex pending_delivery_mutex;
 static std::array<std::deque<std::shared_ptr<MessageDeliveryState>>, 32>
     pending_deliveries;
